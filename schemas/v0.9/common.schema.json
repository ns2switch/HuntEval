{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://hunteval.dev/schemas/v0.9/common.schema.json","title":"HuntEval common primitives v0.9",
  "$defs":{
    "identifier":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "reason_code":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z][a-z0-9_]*$"},
    "safe_relative_path":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "source_kind":{"enum":["run","benchmark","report","topology","diagnosis","improvement","document"]},
    "scope":{"enum":["evaluator_analytics","deployment_visible"]},
    "capability":{"enum":["public_episode_read","managed_tool_request","process_spawn","local_read_only_data"]},
    "limits":{"type":"object","additionalProperties":false,"required":["wall_time_ms","max_input_bytes","max_output_bytes","max_processes","max_concurrency"],"properties":{"wall_time_ms":{"type":"integer","minimum":1},"max_input_bytes":{"type":"integer","minimum":1},"max_output_bytes":{"type":"integer","minimum":1},"max_processes":{"type":"integer","minimum":1},"max_concurrency":{"type":"integer","minimum":1}}}
  }
}
