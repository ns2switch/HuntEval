{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.8/validation-decision.schema.json",
  "title": "HuntEval controlled validation decision v0.8",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "experiment_id", "experiment_sha256", "equivalence_sha256", "improvement_policy_sha256", "status", "paired_samples", "missing_pairs", "metric_deltas", "constraints", "hidden_test_used_in_selection", "human_review_required", "limitations"],
  "properties": {
    "schema_version": {"const": "0.8"}, "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "experiment_id": {"$ref": "common.schema.json#/$defs/identifier"}, "experiment_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "equivalence_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "improvement_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "status": {"enum": ["passed", "failed", "unavailable"]}, "paired_samples": {"type": "integer", "minimum": 0, "maximum": 4096},
    "missing_pairs": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "metric_deltas": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/metric_delta"}},
    "constraints": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/constraint"}},
    "hidden_test_used_in_selection": {"const": false}, "human_review_required": {"const": true},
    "limitations": {"$ref": "common.schema.json#/$defs/reason_codes"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"paired_samples": {"minimum": 1}, "constraints": {"items": {"allOf": [{"$ref": "#/$defs/constraint"}, {"properties": {"status": {"const": "satisfied"}}}]}}}}}],
  "$defs": {
    "metric_delta": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["metric", "version", "baseline", "candidate", "difference", "interval", "applicability"], "properties": {
          "metric": {"$ref": "common.schema.json#/$defs/metric_name"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "baseline": {"type": "number"}, "candidate": {"type": "number"}, "difference": {"type": "number"},
          "interval": {"type": "object", "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number"}, "upper": {"type": "number"}}},
          "applicability": {"const": "available"}
        }},
        {"type": "object", "additionalProperties": false, "required": ["metric", "version", "baseline", "candidate", "difference", "interval", "applicability"], "properties": {
          "metric": {"$ref": "common.schema.json#/$defs/metric_name"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "baseline": {"type": "null"}, "candidate": {"type": "null"}, "difference": {"type": "null"}, "interval": {"type": "null"},
          "applicability": {"enum": ["unavailable", "not_applicable"]}
        }}
      ]
    },
    "constraint": {
      "type": "object", "additionalProperties": false, "required": ["code", "status", "source_metric"],
      "properties": {"code": {"$ref": "common.schema.json#/$defs/reason_code"}, "status": {"enum": ["satisfied", "violated", "unverifiable"]}, "source_metric": {"$ref": "common.schema.json#/$defs/metric_name"}}
    }
  }
}
