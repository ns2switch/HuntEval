{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hunteval.dev/schemas/v0.8/prompt-failure-taxonomy.schema.json",
  "title": "HuntEval prompt and configuration weakness taxonomy v0.8", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "taxonomy_version", "definitions"],
  "properties": {
    "schema_version": {"const": "0.8"}, "id": {"$ref": "common.schema.json#/$defs/identifier"}, "taxonomy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "definitions": {"type": "array", "minItems": 14, "maxItems": 128, "items": {"$ref": "#/$defs/definition"}}
  },
  "$defs": {
    "definition": {"type": "object", "additionalProperties": false, "required": ["code", "description", "target_section_classes", "required_diagnostic_codes", "required_source_families", "allowed_operations"],
      "properties": {
        "code": {"$ref": "common.schema.json#/$defs/reason_code"}, "description": {"$ref": "common.schema.json#/$defs/bounded_text"},
        "target_section_classes": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/mutable_section_class"}},
        "required_diagnostic_codes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reason_code"}},
        "required_source_families": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["trajectory", "agent", "action", "task", "evidence", "finding", "metric", "coordination", "controlled_experiment"]}},
        "allowed_operations": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["add_section", "replace_section", "remove_section", "add_constraint"]}}
      }
    }
  }
}
