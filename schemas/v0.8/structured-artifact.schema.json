{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.8/structured-artifact.schema.json",
  "title": "HuntEval structured artifact v0.8",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "registered_artifact_sha256", "sections"],
  "properties": {
    "schema_version": {"const": "0.8"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "registered_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "sections": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "section": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mutability", "class", "content", "sha256"],
          "properties": {
            "id": {"$ref": "common.schema.json#/$defs/section_id"},
            "mutability": {"const": "immutable"},
            "class": {"$ref": "common.schema.json#/$defs/immutable_section_class"},
            "content": {"type": "string", "minLength": 1, "maxLength": 65536},
            "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mutability", "class", "content", "sha256"],
          "properties": {
            "id": {"$ref": "common.schema.json#/$defs/section_id"},
            "mutability": {"const": "mutable"},
            "class": {"$ref": "common.schema.json#/$defs/mutable_section_class"},
            "content": {"type": "string", "minLength": 1, "maxLength": 65536},
            "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        }
      ]
    }
  }
}
