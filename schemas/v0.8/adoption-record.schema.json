{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hunteval.dev/schemas/v0.8/adoption-record.schema.json",
  "title": "HuntEval externally confirmed adoption record v0.8", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "recommendation_id", "candidate_artifact_sha256", "human_decision_sha256", "adopted_deployment_sha256", "actor_id", "adopted_at", "external_adoption_confirmed"],
  "properties": {
    "schema_version": {"const": "0.8"}, "id": {"$ref": "common.schema.json#/$defs/identifier"}, "recommendation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "candidate_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "human_decision_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "adopted_deployment_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "adopted_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"}, "external_adoption_confirmed": {"const": true}
  }
}
