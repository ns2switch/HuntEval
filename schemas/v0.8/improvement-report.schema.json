{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hunteval.dev/schemas/v0.8/improvement-report.schema.json",
  "title": "HuntEval normalized controlled improvement report v0.8", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "recommendation_id", "status", "baseline_artifact_sha256", "candidate_artifact_sha256", "experiment_sha256", "equivalence_sha256", "validation_decision_sha256", "sections", "limitations"],
  "properties": {
    "schema_version": {"const": "0.8"}, "id": {"$ref": "common.schema.json#/$defs/identifier"}, "recommendation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "status": {"enum": ["proposed", "testing", "validated", "rejected", "approved", "adopted", "invalidated", "superseded"]},
    "baseline_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "candidate_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "experiment_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "equivalence_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "validation_decision_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "sections": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/section"}},
    "limitations": {"$ref": "common.schema.json#/$defs/reason_codes"}
  },
  "$defs": {"section": {"type": "object", "additionalProperties": false, "required": ["id", "stage", "text", "sources"], "properties": {
    "id": {"$ref": "common.schema.json#/$defs/identifier"}, "stage": {"enum": ["observation", "classification", "attribution", "hypothesis", "suggested_change", "experimental_support", "human_decision", "adoption"]},
    "text": {"$ref": "common.schema.json#/$defs/bounded_text"}, "sources": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/report_source"}}
  }}}
}
