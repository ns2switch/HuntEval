{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://hunteval.dev/schemas/v0.8/improvement-bundle-manifest.schema.json",
  "title": "HuntEval controlled improvement bundle manifest v0.8", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "report_sha256", "artifacts"],
  "properties": {
    "schema_version": {"const": "0.8"}, "id": {"$ref": "common.schema.json#/$defs/identifier"}, "report_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "size_bytes"], "properties": {
    "kind": {"enum": ["registered_artifact", "structured_artifact", "artifact_diff", "experiment", "equivalence", "validation_decision", "recommendation", "recommendation_event", "recommendation_state", "human_decision", "adoption_record", "taxonomy", "report", "observable_source"]},
    "path": {"$ref": "common.schema.json#/$defs/safe_relative_path"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
  }}}
}
