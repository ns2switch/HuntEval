{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v1.0/package-inventory.schema.json",
  "title": "HuntEval package inventory v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target": {"type": "string", "minLength": 1, "maxLength": 128},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mode", "path", "sha256", "size"],
        "properties": {
          "mode": {"enum": ["0644", "0755"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 536870912}
        }
      }
    }
  }
}
