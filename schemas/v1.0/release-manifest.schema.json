{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v1.0/release-manifest.schema.json",
  "title": "HuntEval release manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_status", "production_published", "revision", "target", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_status": {"const": "candidate"},
    "production_published": {"const": false},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
