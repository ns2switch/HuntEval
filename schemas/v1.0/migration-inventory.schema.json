{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v1.0/migration-inventory.schema.json",
  "title": "HuntEval migration inventory v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "compatibility_matrix_sha256", "edges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "inventory_id": {"$ref": "#/$defs/identifier"},
    "compatibility_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "edges": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+([.][0-9]+)*$", "maxLength": 32},
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "artifact_family", "source_version", "target_version", "action", "implementation", "fixture_path", "reason_code"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/identifier"},
        "artifact_family": {"$ref": "#/$defs/identifier"},
        "source_version": {"$ref": "#/$defs/version"},
        "target_version": {"anyOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
        "action": {"enum": ["adapt_in_memory", "read_as_is", "reject"]},
        "implementation": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "fixture_path": {"type": ["string", "null"], "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"},
        "reason_code": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}
      }
    }
  }
}
