{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v1.0/compatibility-matrix.schema.json",
  "title": "HuntEval compatibility matrix v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "inventory_sha256", "baseline_revision", "rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matrix_id": {"$ref": "#/$defs/identifier"},
    "inventory_sha256": {"$ref": "#/$defs/digest"},
    "baseline_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rules": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9._-]+$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_id", "version", "fixture_sha256"],
      "properties": {
        "interface_id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "fixture_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combination_id", "components", "status", "rejection_reason", "limitations"],
      "properties": {
        "combination_id": {"$ref": "#/$defs/identifier"},
        "components": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/component"}},
        "status": {"enum": ["supported", "retained", "preview", "unavailable"]},
        "rejection_reason": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "limitations": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    }
  }
}
