{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.7/bottleneck-observations.schema.json",
  "title": "HuntEval runner-authoritative bottleneck observations v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "trajectory_sha256", "intervals", "reassignment_count", "duplicate_work_count", "tool_error_count", "tool_timeout_count", "limitations"],
  "properties": {
    "schema_version": {"const": "0.7"},
    "run_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "trajectory_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "intervals": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/interval"}},
    "reassignment_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "duplicate_work_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "tool_error_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "tool_timeout_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "limitations": {"$ref": "common.schema.json#/$defs/reason_codes"}
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id", "start_event_sequence", "end_event_sequence", "start_time", "end_time", "duration_ms", "applicability", "reason_code"],
      "properties": {
        "kind": {"enum": ["task_queue", "task_execution", "managed_tool_wait", "agent_active", "agent_idle"]},
        "subject_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "start_event_sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000000},
        "end_event_sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000000},
        "start_time": {"anyOf": [{"$ref": "common.schema.json#/$defs/utc_timestamp"}, {"type": "null"}]},
        "end_time": {"anyOf": [{"$ref": "common.schema.json#/$defs/utc_timestamp"}, {"type": "null"}]},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000},
        "applicability": {"$ref": "common.schema.json#/$defs/applicability"},
        "reason_code": {"anyOf": [{"$ref": "common.schema.json#/$defs/reason_code"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"applicability": {"const": "available"}}, "required": ["applicability"]},
          "then": {
            "properties": {
              "start_event_sequence": {"type": "integer"},
              "end_event_sequence": {"type": "integer"},
              "start_time": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
              "end_time": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
              "duration_ms": {"type": "integer"},
              "reason_code": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "start_event_sequence": {"type": "null"},
              "end_event_sequence": {"type": "null"},
              "start_time": {"type": "null"},
              "end_time": {"type": "null"},
              "duration_ms": {"type": "null"},
              "reason_code": {"$ref": "common.schema.json#/$defs/reason_code"}
            }
          }
        }
      ]
    }
  }
}
