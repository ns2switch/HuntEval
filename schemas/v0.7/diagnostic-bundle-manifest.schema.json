{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.7/diagnostic-bundle-manifest.schema.json",
  "title": "HuntEval diagnostic bundle manifest v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "source_revision", "taxonomy_sha256", "classifier_registry_sha256", "artifacts", "root_reports", "limitations"],
  "properties": {
    "schema_version": {"const": "0.7"},
    "bundle_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "source_revision": {"$ref": "common.schema.json#/$defs/sha256"},
    "taxonomy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "classifier_registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/artifact"}},
    "root_reports": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/safe_relative_path"}},
    "limitations": {"$ref": "common.schema.json#/$defs/reason_codes"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "size_bytes", "sha256"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/safe_relative_path"},
        "media_type": {"enum": ["application/json", "text/html"]},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
