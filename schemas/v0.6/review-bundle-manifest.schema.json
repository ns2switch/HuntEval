{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.6/review-bundle-manifest.schema.json",
  "title": "HuntEval private review bundle manifest v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "validation_result_sha256", "files"],
  "properties": {
    "schema_version": {"const": "0.6"}, "episode_id": {"$ref": "common.schema.json#/$defs/identifier"}, "validation_result_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "files": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["label", "sha256", "visibility"], "properties": {"label": {"$ref": "common.schema.json#/$defs/reason_code"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "visibility": {"enum": ["public", "reviewer_only"]}}}}
  }
}
