{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.6/topology-experiment.schema.json",
  "title": "HuntEval controlled topology experiment v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "baseline_topology_sha256", "candidate_topology_sha256", "changed_variables", "control_hashes", "paired_cell_ids"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "baseline_topology_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "candidate_topology_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "changed_variables": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/json_pointer"}},
    "control_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["episodes", "seeds", "budgets", "models", "managed_tool_policy", "scoring_profile", "execution_policy", "schemas", "binaries"],
      "properties": {
        "episodes": {"$ref": "common.schema.json#/$defs/sha256"}, "seeds": {"$ref": "common.schema.json#/$defs/sha256"}, "budgets": {"$ref": "common.schema.json#/$defs/sha256"}, "models": {"$ref": "common.schema.json#/$defs/sha256"}, "managed_tool_policy": {"$ref": "common.schema.json#/$defs/sha256"}, "scoring_profile": {"$ref": "common.schema.json#/$defs/sha256"}, "execution_policy": {"$ref": "common.schema.json#/$defs/sha256"}, "schemas": {"$ref": "common.schema.json#/$defs/sha256"}, "binaries": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "paired_cell_ids": {"type": "array", "minItems": 2, "maxItems": 1000000, "uniqueItems": true, "items": {"type": "string", "pattern": "^cell:[a-f0-9]{64}$"}}
  }
}
