{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.6/dataset-review-record.schema.json",
  "title": "HuntEval private dataset review record v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "episode_id", "reviewer_id", "reviewed_at", "status", "public_package_sha256", "private_ground_truth_sha256", "reference_query_sha256", "review_policy_sha256", "reason_codes"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "review_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "episode_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "reviewer_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "reviewed_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "status": {"enum": ["approved", "rejected"]},
    "public_package_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "private_ground_truth_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "reference_query_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "review_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "reason_codes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reason_code"}}
  }
}
