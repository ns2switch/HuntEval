{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.6/contributor-validation-result.schema.json",
  "title": "HuntEval contributor validation result v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "status", "package_sha256", "checks"],
  "properties": {
    "schema_version": {"const": "0.6"}, "episode_id": {"$ref": "common.schema.json#/$defs/identifier"}, "status": {"enum": ["valid", "invalid", "incomplete"]}, "package_sha256": {"anyOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "checks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "reason_code"], "properties": {"name": {"$ref": "common.schema.json#/$defs/reason_code"}, "status": {"enum": ["passed", "failed", "unavailable"]}, "reason_code": {"anyOf": [{"$ref": "common.schema.json#/$defs/reason_code"}, {"type": "null"}]}}}}
  }
}
