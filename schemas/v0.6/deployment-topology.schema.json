{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.6/deployment-topology.schema.json",
  "title": "HuntEval deployment topology v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "coordination", "model_composition", "memory", "task_allocation", "execution_pattern", "agents", "relationships"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "kind": {"enum": ["single_agent", "supervisor_worker", "hierarchical", "peer_to_peer"]},
    "coordination": {"enum": ["centralized", "decentralized"]},
    "model_composition": {"enum": ["homogeneous", "heterogeneous"]},
    "memory": {"enum": ["shared", "isolated"]},
    "task_allocation": {"enum": ["static", "dynamic"]},
    "execution_pattern": {"enum": ["sequential", "parallel"]},
    "agents": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "role", "specialization", "model_assignment", "memory_group", "reviewer"], "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "role": {"type": "string", "minLength": 1, "maxLength": 128},
        "specialization": {"enum": ["generalist", "supervisor", "identity_specialist", "timeline_specialist", "evidence_reviewer", "critic"]},
        "model_assignment": {"$ref": "common.schema.json#/$defs/identifier"},
        "memory_group": {"$ref": "common.schema.json#/$defs/identifier"},
        "reviewer": {"type": "boolean"}
      }}
    },
    "relationships": {
      "type": "array", "maxItems": 8192,
      "items": {"type": "object", "additionalProperties": false, "required": ["source", "target", "kind"], "properties": {
        "source": {"$ref": "common.schema.json#/$defs/identifier"},
        "target": {"$ref": "common.schema.json#/$defs/identifier"},
        "kind": {"enum": ["delegates_to", "coordinates_with", "reviews"]}
      }}
    }
  }
}
