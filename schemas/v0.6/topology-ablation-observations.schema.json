{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.6/topology-ablation-observations.schema.json",
  "title": "HuntEval paired topology-ablation observations v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline", "candidate"],
  "properties": {
    "baseline": {"$ref": "#/$defs/metric_observations"},
    "candidate": {"$ref": "#/$defs/metric_observations"}
  },
  "$defs": {
    "metric_observations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,95}$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000000,
        "items": {"type": ["number", "null"]}
      }
    }
  }
}
