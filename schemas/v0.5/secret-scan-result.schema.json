{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.5/secret-scan-result.schema.json",
  "title": "HuntEval secret scan result v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "scanned_artifacts", "findings", "incomplete_reasons"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "status": {"enum": ["clean", "findings", "incomplete"]},
    "scanned_artifacts": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "incomplete_reasons": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$"}
    },
    "findings": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "artifact", "line", "fingerprint"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$"},
          "artifact": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9._/-]+$"},
          "line": {"type": "integer", "minimum": 1, "maximum": 1000000000},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
