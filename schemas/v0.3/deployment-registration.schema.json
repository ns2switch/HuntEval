{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.3/deployment-registration.schema.json",
  "title": "HuntEval deployment registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "architecture", "version", "agents"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "architecture": {"enum": ["single_agent", "supervisor_worker", "hierarchical", "peer_to_peer", "external"]},
    "version": {"type": "string", "minLength": 1},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "capabilities", "prompt_version", "prompt_sha256", "model"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "role": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prompt_version": {"type": "string", "minLength": 1},
          "prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "model": {"type": "string", "minLength": 1},
          "model_parameters": {"type": "object"}
        }
      }
    }
  }
}
