{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.4/benchmark-manifest.schema.json",
  "title": "HuntEval authored benchmark manifest v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "deployments", "episodes", "seeds", "scoring_profile"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "deployments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/safe_relative_path"}
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/safe_relative_path"}
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
    },
    "scoring_profile": {"$ref": "common.schema.json#/$defs/safe_relative_path"},
    "fault_profile": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/safe_relative_path"},
        {"type": "null"}
      ]
    }
  }
}
