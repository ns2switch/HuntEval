{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.4/report-claim.schema.json",
  "title": "HuntEval typed report claim v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "text", "sources"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "claim_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "text": {"type": "string", "minLength": 1, "maxLength": 16384},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "oneOf": [
        {"$ref": "#/$defs/metric_pointer"},
        {"$ref": "#/$defs/trajectory_sequence"},
        {"$ref": "#/$defs/run"},
        {"$ref": "#/$defs/benchmark_cell"},
        {"$ref": "#/$defs/constraint"},
        {"$ref": "#/$defs/statistical_comparison"},
        {"$ref": "#/$defs/artifact_digest"}
      ]
    },
    "metric_pointer": {
      "type": "object", "additionalProperties": false, "required": ["kind", "run_id", "pointer"],
      "properties": {"kind": {"const": "metric_pointer"}, "run_id": {"$ref": "common.schema.json#/$defs/identifier"}, "pointer": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$", "maxLength": 4096}}
    },
    "trajectory_sequence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "run_id", "sequence"],
      "properties": {"kind": {"const": "trajectory_sequence"}, "run_id": {"$ref": "common.schema.json#/$defs/identifier"}, "sequence": {"type": "integer", "minimum": 1}}
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["kind", "run_id"],
      "properties": {"kind": {"const": "run"}, "run_id": {"$ref": "common.schema.json#/$defs/identifier"}}
    },
    "benchmark_cell": {
      "type": "object", "additionalProperties": false, "required": ["kind", "benchmark_id", "cell_id"],
      "properties": {"kind": {"const": "benchmark_cell"}, "benchmark_id": {"$ref": "common.schema.json#/$defs/identifier"}, "cell_id": {"type": "string", "pattern": "^cell:[a-f0-9]{64}$"}}
    },
    "constraint": {
      "type": "object", "additionalProperties": false, "required": ["kind", "scope_id", "constraint_id"],
      "properties": {"kind": {"const": "constraint"}, "scope_id": {"$ref": "common.schema.json#/$defs/identifier"}, "constraint_id": {"$ref": "common.schema.json#/$defs/identifier"}}
    },
    "statistical_comparison": {
      "type": "object", "additionalProperties": false, "required": ["kind", "comparison_id"],
      "properties": {"kind": {"const": "statistical_comparison"}, "comparison_id": {"$ref": "common.schema.json#/$defs/identifier"}}
    },
    "artifact_digest": {
      "type": "object", "additionalProperties": false, "required": ["kind", "artifact", "sha256"],
      "properties": {"kind": {"const": "artifact_digest"}, "artifact": {"$ref": "common.schema.json#/$defs/identifier"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}
    }
  }
}
