{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.4/submission.schema.json",
  "title": "HuntEval final submission v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "summary", "finding_ids", "malicious_event_ids", "malicious_entity_ids", "attack_path", "attack_techniques", "confidence", "timeline"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "status": {"enum": ["confirmed_malicious_activity", "suspicious_activity", "no_malicious_activity", "inconclusive"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 16384},
    "finding_ids": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "malicious_event_ids": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "malicious_entity_ids": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "attack_path": {"type": "array", "maxItems": 100000, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "attack_techniques": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "maxItems": 1024, "items": {"type": "string", "maxLength": 4096}},
    "timeline": {"type": "array", "maxItems": 100000, "items": {"$ref": "common.schema.json#/$defs/timeline_entry"}}
  }
}
