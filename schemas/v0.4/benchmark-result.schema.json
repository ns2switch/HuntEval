{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.4/benchmark-result.schema.json",
  "title": "HuntEval normalized benchmark result v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "benchmark_id", "benchmark_definition_sha256",
    "benchmark_state_sha256", "scoring_profile_sha256", "cells", "deployments",
    "comparisons", "rankings", "claims", "artifacts", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.4"},
    "benchmark_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "benchmark_definition_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "benchmark_state_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "scoring_profile_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "cells": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/cell"}},
    "deployments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deployment"}},
    "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "rankings": {"type": "array", "items": {"$ref": "#/$defs/ranking"}},
    "claims": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/claim"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "limitations": {
      "type": "array", "maxItems": 1024,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  },
  "$defs": {
    "cell_id": {"type": "string", "pattern": "^cell:[a-f0-9]{64}$"},
    "nullable_number": {"type": ["number", "null"]},
    "statistical_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "mean", "interval"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "mean": {"$ref": "#/$defs/nullable_number"},
        "interval": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["lower", "upper", "confidence"],
              "properties": {
                "lower": {"type": "number"}, "upper": {"type": "number"},
                "confidence": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            }
          ]
        }
      }
    },
    "metric_value": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "applicability", "direction", "range", "numerator", "denominator"],
      "properties": {
        "value": {"$ref": "#/$defs/nullable_number"},
        "applicability": {"type": "string", "minLength": 1},
        "direction": {"enum": ["higher_is_better", "lower_is_better"]},
        "range": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {"minimum": {"type": "number"}, "maximum": {"type": "number"}}
        },
        "numerator": {"type": ["integer", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "resource_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_ms", "tool_calls", "sql_queries", "messages", "input_tokens", "output_tokens", "token_provenance", "estimated_cost"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "sql_queries": {"type": "integer", "minimum": 0},
        "messages": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "token_provenance": {"enum": ["measured", "verified_adapter", "self_reported", "unavailable"]},
        "estimated_cost": {
          "type": "object", "additionalProperties": false,
          "required": ["value", "provenance", "currency"],
          "properties": {
            "value": {"type": ["number", "null"], "minimum": 0},
            "provenance": {"enum": ["measured", "verified_adapter", "self_reported", "unavailable"]},
            "currency": {"type": ["string", "null"]}
          }
        }
      }
    },
    "digest_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "deployment_id", "episode_id", "seed", "status", "reason_code", "run_id", "result_sha256", "aggregate_score", "aggregate_score_omissions", "metrics", "constraints", "resource_usage", "submitted_timeline", "artifacts"],
      "properties": {
        "cell_id": {"$ref": "#/$defs/cell_id"},
        "deployment_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "episode_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "seed": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "running", "completed", "failed", "non_comparable"]},
        "reason_code": {"type": ["string", "null"], "maxLength": 256},
        "run_id": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/identifier"}]},
        "result_sha256": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]},
        "aggregate_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "aggregate_score_omissions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric_value"}},
        "constraints": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "status", "disqualifying"],
            "properties": {
              "code": {"$ref": "common.schema.json#/$defs/identifier"},
              "status": {"enum": ["satisfied", "violated", "unverifiable"]},
              "disqualifying": {"type": "boolean"}
            }
          }
        },
        "resource_usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resource_usage"}]},
        "submitted_timeline": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/timeline_entry"}},
        "artifacts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/digest_reference"}}
      }
    },
    "metric_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "values", "statistics"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "values": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nullable_number"}},
        "statistics": {"$ref": "#/$defs/statistical_summary"}
      }
    },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["deployment_id", "completed_cells", "failed_cells", "pending_cells", "non_comparable_cells", "disqualifying_constraints", "aggregate_score", "metrics"],
      "properties": {
        "deployment_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "completed_cells": {"type": "integer", "minimum": 0},
        "failed_cells": {"type": "integer", "minimum": 0},
        "pending_cells": {"type": "integer", "minimum": 0},
        "non_comparable_cells": {"type": "integer", "minimum": 0},
        "disqualifying_constraints": {"type": "integer", "minimum": 0},
        "aggregate_score": {"$ref": "#/$defs/statistical_summary"},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric_summary"}}
      }
    },
    "paired_difference": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "mean_difference", "interval", "wins", "ties", "losses", "conclusive"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "mean_difference": {"$ref": "#/$defs/nullable_number"},
        "interval": {"$ref": "#/$defs/statistical_summary/properties/interval"},
        "wins": {"type": "integer", "minimum": 0}, "ties": {"type": "integer", "minimum": 0},
        "losses": {"type": "integer", "minimum": 0}, "conclusive": {"type": "boolean"}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_id", "left", "right", "eligible", "reasons", "cell_ids", "aggregate_difference"],
      "properties": {
        "comparison_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "left": {"$ref": "common.schema.json#/$defs/identifier"},
        "right": {"$ref": "common.schema.json#/$defs/identifier"},
        "eligible": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cell_ids": {"type": "array", "items": {"$ref": "#/$defs/cell_id"}},
        "aggregate_difference": {"$ref": "#/$defs/paired_difference"}
      }
    },
    "ranking": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "deployments", "disqualifying_constraints", "aggregate_score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "deployments": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
        "disqualifying_constraints": {"type": "integer", "minimum": 0},
        "aggregate_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "claim_source": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "benchmark_id", "cell_id"], "properties": {"kind": {"const": "benchmark_cell"}, "benchmark_id": {"$ref": "common.schema.json#/$defs/identifier"}, "cell_id": {"$ref": "#/$defs/cell_id"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "run_id", "pointer"], "properties": {"kind": {"const": "metric_pointer"}, "run_id": {"$ref": "common.schema.json#/$defs/identifier"}, "pointer": {"type": "string", "pattern": "^/"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "scope_id", "constraint_id"], "properties": {"kind": {"const": "constraint"}, "scope_id": {"$ref": "common.schema.json#/$defs/identifier"}, "constraint_id": {"$ref": "common.schema.json#/$defs/identifier"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "comparison_id"], "properties": {"kind": {"const": "statistical_comparison"}, "comparison_id": {"$ref": "common.schema.json#/$defs/identifier"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "artifact", "sha256"], "properties": {"kind": {"const": "artifact_digest"}, "artifact": {"$ref": "common.schema.json#/$defs/safe_relative_path"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}}}
      ]
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "text", "sources"],
      "properties": {
        "claim_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384},
        "sources": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/claim_source"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/safe_relative_path"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
