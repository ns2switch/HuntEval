{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunteval.dev/schemas/v0.4/deployment-registration.schema.json",
  "title": "HuntEval deployment registration v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "architecture", "version", "agents", "process"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "architecture": {"enum": ["single_agent", "supervisor_worker", "hierarchical", "peer_to_peer", "external"]},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "capabilities", "prompt_version", "prompt_sha256", "model"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "role": {"type": "string", "minLength": 1, "maxLength": 256},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
          "prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "model": {"type": "string", "minLength": 1, "maxLength": 512},
          "model_parameters": {"type": "object", "maxProperties": 256}
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "environment_allowlist"],
      "properties": {
        "executable": {"$ref": "common.schema.json#/$defs/safe_relative_path"},
        "arguments": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "string", "maxLength": 4096}
        },
        "environment_allowlist": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
        }
      }
    }
  }
}
