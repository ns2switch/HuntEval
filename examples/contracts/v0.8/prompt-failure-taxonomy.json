{
  "schema_version": "0.8", "id": "prompt-configuration-weaknesses-v1", "taxonomy_version": "1.0.0",
  "definitions": [
    {"code": "role_ambiguity", "description": "The registered role has no bounded responsibility statement.", "target_section_classes": ["task_planning"], "required_diagnostic_codes": ["capability_mismatch"], "required_source_families": ["agent", "task"], "allowed_operations": ["add_constraint", "replace_section"]},
    {"code": "missing_output_contract", "description": "The instruction artifact does not define its required structured output.", "target_section_classes": ["output_contract"], "required_diagnostic_codes": ["invalid_output"], "required_source_families": ["trajectory"], "allowed_operations": ["add_section"]},
    {"code": "missing_evidence_requirements", "description": "Findings are not required to cite grounded evidence.", "target_section_classes": ["evidence_requirements"], "required_diagnostic_codes": ["ungrounded_finding"], "required_source_families": ["finding", "evidence"], "allowed_operations": ["add_constraint"]},
    {"code": "missing_acceptance_criteria", "description": "The artifact lacks bounded criteria for accepting a finding.", "target_section_classes": ["evidence_requirements", "output_contract"], "required_diagnostic_codes": ["unsupported_conclusion"], "required_source_families": ["finding", "metric"], "allowed_operations": ["add_constraint"]},
    {"code": "missing_stopping_condition", "description": "The investigation has no observable stopping rule.", "target_section_classes": ["stopping_conditions"], "required_diagnostic_codes": ["tool_budget_exhausted"], "required_source_families": ["action", "metric"], "allowed_operations": ["add_section", "add_constraint"]},
    {"code": "unclear_tool_use_policy", "description": "Mutable instructions do not explain when a managed tool should be requested.", "target_section_classes": ["task_planning"], "required_diagnostic_codes": ["repeated_query"], "required_source_families": ["action"], "allowed_operations": ["add_constraint"]},
    {"code": "insufficient_error_handling", "description": "The artifact lacks a bounded recovery action after a tool error.", "target_section_classes": ["error_recovery"], "required_diagnostic_codes": ["ignored_tool_error"], "required_source_families": ["action", "trajectory"], "allowed_operations": ["add_section", "replace_section"]},
    {"code": "insufficient_delegation_policy", "description": "Delegation rules do not bind tasks to declared capabilities.", "target_section_classes": ["delegation_strategy"], "required_diagnostic_codes": ["incorrect_delegation"], "required_source_families": ["agent", "task"], "allowed_operations": ["add_constraint"]},
    {"code": "duplicated_responsibility", "description": "Multiple roles receive the same unbounded responsibility.", "target_section_classes": ["delegation_strategy"], "required_diagnostic_codes": ["duplicate_task_creation"], "required_source_families": ["agent", "task"], "allowed_operations": ["replace_section"]},
    {"code": "missing_task_ownership", "description": "Created tasks are not required to have one declared owner.", "target_section_classes": ["delegation_strategy"], "required_diagnostic_codes": ["duplicate_task_creation"], "required_source_families": ["task", "coordination"], "allowed_operations": ["add_constraint"]},
    {"code": "missing_conflict_resolution_policy", "description": "Conflicting findings have no bounded resolution process.", "target_section_classes": ["communication_format"], "required_diagnostic_codes": ["unresolved_conflict"], "required_source_families": ["coordination", "finding"], "allowed_operations": ["add_section", "add_constraint"]},
    {"code": "excessive_communication_requirements", "description": "Instructions require communication without an observable downstream purpose.", "target_section_classes": ["communication_format"], "required_diagnostic_codes": ["excessive_message_loop"], "required_source_families": ["coordination", "metric"], "allowed_operations": ["replace_section"]},
    {"code": "insufficient_evidence_sharing_rules", "description": "Grounded evidence is not required to reach the responsible agent.", "target_section_classes": ["evidence_requirements", "communication_format"], "required_diagnostic_codes": ["evidence_not_shared"], "required_source_families": ["evidence", "coordination"], "allowed_operations": ["add_constraint"]},
    {"code": "overly_broad_specialist_invocation_criteria", "description": "Specialist invocation criteria are broader than declared task needs.", "target_section_classes": ["delegation_strategy"], "required_diagnostic_codes": ["unnecessary_specialist_invocation"], "required_source_families": ["agent", "task", "metric"], "allowed_operations": ["replace_section", "add_constraint"]}
  ]
}
